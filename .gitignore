# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# --- FMOD LOCAL CONFIG ---
# Ignoramos la carpeta completa del plugin para que cada uno use la de su OS
Plugins/FMODStudio*/

# Pero nos aseguramos de NO ignorar el contenido de audio en Content
!Content/FMOD/

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
Plugins/FMODStudio/Binaries/Win64/UnrealEditor-FMODStudioEditor.dll
Plugins/FMODStudio/Binaries/Win64/UnrealEditor-FMODStudio.dll
Plugins/FMODStudio/Binaries/Win64/fmodstudioL.dll
Plugins/FMODStudio/Binaries/Win64/fmodL.dll
